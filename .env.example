# Neon Postgres Connection Strings
# DATABASE_URL: Pooled connection string for regular app queries
DATABASE_URL=

# DIRECT_DATABASE_URL: Direct unpooled connection string for migrations (drizzle-kit)
DIRECT_DATABASE_URL=

# ENCRYPTION_KEY: 32 bytes key encoded as base64 (for AES-256-GCM token encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=